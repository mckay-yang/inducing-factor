{
  "class_grid": {
    "raster": "data/disturbance_class/disturbance_class_res.tif",
    "start_year": 2016
  },
  "data_sources": {
    "aoi_shapefile": "data/aoi/LangToBasighat.shp",
    "dem_raster": "data/dem/tibet_dem.tif",
    "ccdc_dir": "data/ccdc_res",
    "rainfall_dir": "data/rainfall",
    "temperature_dir": "data/temperature",
    "landuse_dir": "data/landuse",
    "resident_raster": "data/resident/GURS_2020.tif",
    "river_shapefile": "data/river/As_15s_Chimaps.shp",
    "road_dir": "data/road"
  },
  "data_usage": {
    "production": {
      "dem": true,
      "ccdc": true,
      "rainfall": true,
      "temperature": true,
      "landuse": true,
      "resident": true,
      "river": false,
      "road": false
    },
    "smoke_test": {
      "dem": true,
      "ccdc": true,
      "rainfall": true,
      "temperature": true,
      "landuse": true,
      "resident": true,
      "river": false,
      "road": false
    }
  },
  "data_process": {
    "cache_dir": ".cache",
    "tile_size": 256,
    "temporal_context_years": 1,
    "workers": 8
  },
  "train": {
    "training_years": [
      2017,
      2018,
      2019,
      2020,
      2021,
      2022,
      2023,
      2024
    ],
    "model_dir": "results/models",
    "missing_data_policy": "native_missing_category",
    "discretizer_method": "quantile",
    "discretize_bins": 3,
    "max_pattern_size": 3,
    "min_support": 0.01,
    "min_relative_risk": 1.0,
    "min_stability": 0.0,
    "bootstrap_iterations": 10,
    "max_bootstrap_samples": 600,
    "max_network_factors": 128,
    "random_state": 42,
    "workers": 0
  },
  "predict": {
    "prediction_year": 2025,
    "output_dir": "results/predictions",
    "products": [
      "probability",
      "dominant_factor",
      "disturbance_type",
      "disturbance_type_probability",
      "missing_data_mask"
    ],
    "workers": 0
  }
}
